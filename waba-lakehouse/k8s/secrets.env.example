# =============================================================================
# Secrets du Level 4 (Kubernetes) — VALEURS D'EXEMPLE.
# `make k8s-secrets` crée k8s/secrets.env avec des valeurs ALÉATOIRES si le fichier
# n'existe pas ; pour choisir vos valeurs : cp k8s/secrets.env.example k8s/secrets.env
# puis éditer (12 caractères minimum pour WABA_DEMO_PASSWORD).
# =============================================================================

# Administrateur de la console Keycloak (utilisateur admin)
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password

# Mot de passe des 5 comptes de démonstration (12 caractères min.)
WABA_DEMO_PASSWORD=change-me-waba-demo-password

# Compte local de secours de Superset (admin)
SUPERSET_ADMIN_PASSWORD=change-me-superset-admin-password

# Clé de signature des sessions Superset
SUPERSET_SECRET_KEY=change-me-superset-secret-key

# PostgreSQL de Superset
SUPERSET_DB_PASSWORD=change-me-superset-db-password

# Secret du client OIDC « superset » dans Keycloak
SUPERSET_OIDC_CLIENT_SECRET=change-me-superset-oidc-client-secret

# Secret du client OIDC « trino » dans Keycloak
TRINO_OIDC_CLIENT_SECRET=change-me-trino-oidc-client-secret

# Secret de communication interne de Trino
TRINO_SHARED_SECRET=change-me-trino-shared-secret

# Compte de service Trino « superset »
TRINO_SUPERSET_PASSWORD=change-me-trino-superset-password

# Compte de service Trino « prometheus » (/metrics)
TRINO_PROMETHEUS_PASSWORD=change-me-trino-prometheus-password

# Compte de service Trino « openmetadata »
TRINO_OPENMETADATA_PASSWORD=change-me-trino-openmetadata-password

# Superutilisateur PostgreSQL de la gouvernance
GOVERNANCE_DB_PASSWORD=change-me-governance-db-password

# Base PostgreSQL de Keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db-password

# Base PostgreSQL d'OpenMetadata
OPENMETADATA_DB_PASSWORD=change-me-openmetadata-db-password

# Administrateur Grafana (utilisateur admin)
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin-password
