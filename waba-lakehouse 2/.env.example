# =============================================================================
# Variables d'environnement — WABA Lakehouse (Levels 1 à 3)
# Copier en .env :  cp .env.example .env   (le fichier .env est ignoré par git)
# VALEURS D'EXEMPLE UNIQUEMENT : remplacez-les, ne commitez jamais de vrais secrets.
# =============================================================================

# --- MinIO : compte administrateur (utilisé seulement par minio-init) ---------
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=change-me-admin-password

# --- MinIO : compte de service des applications (Streamlit, Spark, Trino, REST)
# Créé par minio/init.sh avec une policy limitée aux buckets raw-landing,
# lakehouse et archive. Secret : 8 caractères minimum.
LAKEHOUSE_S3_ACCESS_KEY=lakehouse-svc
LAKEHOUSE_S3_SECRET_KEY=change-me-service-secret

# --- Région S3 (MinIO l'ignore mais les SDK AWS l'exigent) ---------------------
AWS_REGION=us-east-1

# =============================================================================
# Level 2
# =============================================================================
# Secret de pseudonymisation des identifiants clients/comptes en Silver/Gold
# (hash SHA-256 salé). Le changer rend les anciennes clés incomparables.
PII_HASH_SECRET=change-me-pii-secret

# --- Airflow ------------------------------------------------------------------
AIRFLOW_ADMIN_PASSWORD=change-me-airflow-admin
AIRFLOW_DB_PASSWORD=change-me-airflow-db
# Clé Fernet (chiffrement des connexions en base). Générer la vôtre :
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=Hh1u2Vn8x3KQm4Lr5Tq6Wy7Zb8Cd9Ef0Gh1Ij2Kl3Mn=
# Secrets partagés entre composants Airflow (valeurs longues et aléatoires)
AIRFLOW_JWT_SECRET=change-me-jwt-secret-with-at-least-32-characters
AIRFLOW_API_SECRET_KEY=change-me-api-secret-key
# Webhook d'alerte (Slack / Teams / autre) appelé en cas d'échec d'une tâche. Vide = logs seuls.
ALERT_WEBHOOK_URL=
# Fréquence de dag_ingest_raw (cron) et nombre de jobs Spark simultanés
WABA_INGEST_SCHEDULE="*/15 * * * *"
SPARK_POOL_SLOTS=1

# =============================================================================
# Level 3 — streaming (NiFi -> Kafka -> Spark Structured Streaming)
# =============================================================================
# Active les services du profil « streaming » de docker-compose (vide = L1+L2 seuls)
COMPOSE_PROFILES=streaming
# NiFi (single-user, HTTPS https://localhost:8443/nifi). Mot de passe : 12 caractères minimum.
NIFI_USERNAME=nifi-admin
NIFI_PASSWORD=change-me-nifi-password
# Clé de chiffrement des propriétés sensibles du flux NiFi (12 caractères minimum)
NIFI_SENSITIVE_PROPS_KEY=change-me-nifi-props-key
# false : NiFi ne publie que les fichiers déposés APRÈS son provisioning ;
# true  : rejoue aussi tout l'historique présent dans raw-landing (volumineux)
NIFI_REPLAY_HISTORY=false
# true : supprime et recrée le flux NiFi au prochain `make nifi-provision`
NIFI_RECREATE=false
# Intervalle des micro-lots Spark Structured Streaming (secondes)
STREAM_TRIGGER_S=5
